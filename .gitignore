# ============================================================
# 医院药品运输系统 根 .gitignore（适用于全部 5 个子项目）
# ============================================================

# ===== 敏感文件（公开仓库不上传密码 / 私钥）=====
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx

# ===== Node.js =====
node_modules/
dist/
.vite/
.next/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
vite.config.ts.timestamp-*

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.db
*.db-journal
*.sqlite
*.sqlite3
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== ESP-IDF 构建产物 =====
build/
managed_components/
sdkconfig.old
.cache/

# ===== ESP32 运行日志 / 临时输出 =====
error.txt
message.txt
debug.log

# ===== IDE / 编辑器 =====
.vscode/
.idea/
*.swp
*.swo

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini
