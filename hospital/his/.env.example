# HIS backend
HIS_BACKEND_HOST=0.0.0.0
HIS_BACKEND_PORT=3001
CORS_ORIGIN=*
JSON_BODY_LIMIT=6mb

# HIS frontend / Vite
HIS_FRONTEND_HOST=0.0.0.0
HIS_FRONTEND_PORT=3002
HIS_FRONTEND_STRICT_PORT=true
HIS_VITE_FORCE=true
VITE_API_TARGET=http://127.0.0.1:3001
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=10000
HIS_API_TARGET_SCHEME=http
HIS_API_TARGET_HOST=127.0.0.1

# MySQL
MYSQL_HOST=192.168.51.13
MYSQL_PORT=3306
MYSQL_USER=ros
MYSQL_PASS=change-me
MYSQL_DB=test
MYSQL_CONNECTION_LIMIT=10
MYSQL_CHARSET=utf8mb4

# Authentication and audit chain
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
AUDIT_HASH_SALT=replace-with-a-random-salt

# External services
FACE_COMPARE_URL=http://127.0.0.1:8000/api/v1/face
FACE_COMPARE_TIMEOUT_MS=15000
HOSPITAL_BACKEND_URL=http://127.0.0.1:8080/api/v1
HOSPITAL_BACKEND_TIMEOUT_MS=5000

# Local HTTPS certificate and launcher
HIS_HTTPS_CERT_DIR=client
HIS_HTTPS_CERT_HOST=localhost
HIS_HTTPS_CERT_IP=127.0.0.1
HIS_HTTPS_CERT_DAYS=365
HIS_LOCAL_HOST=localhost
HIS_PORT_SCAN_RANGE=30
