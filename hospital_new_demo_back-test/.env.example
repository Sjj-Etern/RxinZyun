# ============================================================
# hospital_new_demo 后端配置文件示例
# 复制此文件为 .env 并修改配置值
# ============================================================

# ===== 应用基础配置 =====
APP_NAME=Medicine API Server
DATABASE_URL=sqlite:///./app.db

# ===== HIS 系统数据库配置 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=527725
MYSQL_DB=hospital

# ===== 海康摄像头配置（RTSP） =====
CAMERA_HOST=192.168.51.251
CAMERA_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=Gsydj666
CAMERA_STREAM_PATH=/Streaming/Channels/101

# ===== 摄像头语音播报配置（ISAPI） =====
CAMERA_AUDIO_PORT=80
AUDIO_ID_START=15
AUDIO_ID_END=14
AUDIO_CHECK_INTERVAL=30
AUDIO_CONNECT_TIMEOUT=5

# ===== ROS WebSocket 配置 =====
ROS_WS_HOST=192.168.51.43
ROS_WS_PORT=9090
ROS_TOPIC=/car01_pub
ROS_CHECK_INTERVAL=30
ROS_CONNECT_TIMEOUT=5

# ===== 机器人摄像头1（ROS webvideo_server） =====
ROBOT1_HOST=192.168.51.12
ROBOT1_PORT=8080

# ===== 机器人摄像头2 =====
ROBOT2_HOST=192.168.51.43
ROBOT2_PORT=5000