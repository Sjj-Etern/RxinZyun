# 医院大屏后端配置。复制为 .env 后填写；所有运行配置均由此文件提供。
# 密码、真实内网地址和生产备份不得提交 Git。

# ===== 应用 =====
# 服务名称，仅用于日志与接口展示。
APP_NAME=Medicine API Server

# ===== HIS / 大屏共享 MySQL =====
# HIS MySQL 服务地址、端口、账号、密码和数据库名。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace-with-your-mysql-user
MYSQL_PASS=replace-with-your-mysql-password
MYSQL_DB=hospital

# ===== 海康摄像头 RTSP 与语音播报 =====
# RTSP 主机、端口、账号、密码及视频通道路径；CAMERA_PASSWORD 必须填真实设备密码。
CAMERA_HOST=replace-with-your-camera-host
CAMERA_PORT=554
CAMERA_USER=replace-with-your-camera-user
CAMERA_PASSWORD=replace-with-your-camera-password
CAMERA_STREAM_PATH=/Streaming/Channels/101
# 海康 ISAPI 语音接口端口，以及任务开始/送达对应的设备音频 ID。
CAMERA_AUDIO_PORT=80
AUDIO_ID_START=15
AUDIO_ID_END=14
# 语音端口健康检查间隔和连接超时，单位秒。
AUDIO_CHECK_INTERVAL=30
AUDIO_CONNECT_TIMEOUT=5

# ===== ROS / rosbridge：车 1 =====
# WebSocket 地址；TOPIC 为车向大屏上报状态，POSE_TOPIC 为 x,y 实时坐标，SEND_TOPIC 为大屏下发任务。
CAR1_WS_HOST=replace-with-car1-ros-host
CAR1_WS_PORT=9090
CAR1_TOPIC=/car01_pub
CAR1_POSE_TOPIC=/car01_pose
CAR1_SEND_TOPIC=/rxzy_msg
CAR1_SEND_MSG_TYPE=his_sub

# ===== ROS / rosbridge：车 2 =====
CAR2_WS_HOST=replace-with-car2-ros-host
CAR2_WS_PORT=9090
CAR2_TOPIC=/car02_pub
CAR2_POSE_TOPIC=/car02_pose
CAR2_SEND_TOPIC=/car02_rxzy_msg
CAR2_SEND_MSG_TYPE=his_sub

# ===== ROS 通信节奏 =====
# 断线可用性检查周期、单次连接超时，单位秒。
ROS_CHECK_INTERVAL=30
ROS_CONNECT_TIMEOUT=5
# 车 1 的 start/running 重发上限，以及停止重发后等待回执的最长时间，单位秒。
MEDICINE_SEND_MAX_ATTEMPTS=15
MEDICINE_RECEIPT_WAIT_TIMEOUT=300

# ===== 双车信号 =====
# LIFT_ACROSS_DELAY 为历史兼容字段；其余为车 2 信号与 HIS 扫码触发的延迟，单位秒。
LIFT_ACROSS_DELAY=60
CAR2_SIGNAL_INTERVAL=2
PHARMACIST_SUCCESS_DELAY=0
NURSE_SUCCESS_DELAY=0

# ===== 电梯 ESP32 TCP / UDP =====
# TCP 服务监听地址和端口；UDP 为 ESP32 发现后端时使用的端口。
ELEVATOR_TCP_HOST=0.0.0.0
ELEVATOR_TCP_PORT=10833
ELEVATOR_UDP_PORT=10832
# 命令 ACK、开门、关门、每层移动和 floor_arrived 兜底超时，单位秒。
ELEVATOR_CMD_TIMEOUT=10
ELEVATOR_TARGET_FLOOR=4
ELEVATOR_DOOR_OPEN_DELAY=3
ELEVATOR_DOOR_CLOSE_DELAY=3
ELEVATOR_GO_FLOOR_DELAY=5
ELEVATOR_FLOOR_ARRIVE_TIMEOUT=20
# 车 2 收到 lift-across 后，等待其进入电梯再发上楼命令的时间，单位秒。
ELEVATOR_ACROSS_TO_GO_FLOOR_DELAY=5

# ===== 机器人摄像头 HTTP 流 =====
# 车 1 为 ROS webvideo_server；车 2 为 video_feed HTTP 服务。
ROBOT1_HOST=replace-with-car1-camera-host
ROBOT1_PORT=8080
ROBOT2_HOST=replace-with-car2-camera-host
ROBOT2_PORT=5000
